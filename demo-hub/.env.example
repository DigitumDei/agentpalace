# Copy to .env and fill these two values. No Google resources are created by Compose.
DEMO_HUB_GOOGLE_CLIENT_ID=replace-with-your-google-web-client-id
DEMO_HUB_BOOTSTRAP_ADMIN_EMAIL=you@gmail.com
# Real local embeddings by default; first boot downloads the model into palace_data.
AGENTPALACE_STUB_EMBEDDINGS=0
AGENTPALACE_EMBED_ALLOW_DOWNLOADS=1
# For a verified non-Gmail admin mailbox only:
# DEMO_HUB_ADMIN_MAILBOX_PROVEN=true